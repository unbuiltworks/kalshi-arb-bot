             return _json.loads(r.read() or b"{}")
 
 
+#: the ONE mutating route a disarmed process may reach. Anchored: no
+#: account-wide variant, no second path segment and no query string matches.
+CANCEL_ROUTE = re.compile(r"^/v1/order/[A-Za-z0-9_-]+/cancel$")
+
+
+class _CancelOnlyHTTP(_SignedHTTP):
+    """Signed HTTP that can GET, and can POST exactly one cancel route.
+
+    THE PRODUCTION DEFECT THIS REPAIRS. `cancel()` deliberately dropped its
+    `_require_armed()` gate so a DISARMED process -- the state every orphan
+    and deadman path runs in -- could still withdraw an order it owns. But
+    `self.http` is `pmus_auth.ReadOnlyTransport` while disarmed, and that
+    object raises PermissionError on any method but GET. So the POST died one
+    layer BELOW the gate that had been removed for it, and the capability
+    never existed. Observed live, twice, each on a real resting order:
+
+      2026-10-15T19:50:03Z  D47R06GG0ZRX  cpc-btc-...-1945z
+                            cancel_error PermissionError, left ORDER_STATE_NEW
+      2026-10-16T03:39:06Z  D4EFZNW00ZZ0  cpcxrp-xrp-...-0330z
+                            cancel_error PermissionError on every sweep while
+                            cumQuantity climbed 37.73 -> 47.92
+
+    The second settled worthless at -37.9754, the largest single line in the
+    account's realized loss. Nothing withdrew either order; what cleared them
+    was the venue expiring them at market close.
+
+    ISOLATION IS PRESERVED, NOT TRADED AWAY. This is not a general transport
+    handed to the cancel path: the refusal lives in the object, exactly as it
+    does in `ReadOnlyTransport`, so a process holding this cannot be argued
+    into a submit. Ownership is proved against the durable ledger BEFORE this
+    is reached, the id is the venue's own, and there is no market-scoped and
+    no account-wide route here.
+    """
+
+    def request(self, method: str, path: str,
+                body: Optional[Mapping[str, Any]] = None,
+                base: str = Q1.API) -> Any:
+        m = str(method).upper()
+        if m == "GET" or (m == "POST" and CANCEL_ROUTE.match(str(path) or "")):
+            return super().request(m, path, body, base)
+        raise PermissionError(
+            "%s %s refused: this transport may only GET, or POST a single "
+            "/v1/order/{id}/cancel" % (method, path))
+
+
 #: the market slug carries a `cpc-` product prefix that the EVENT slug does
 #: not: market cpc-btc-updown-15m-2026-09-24-1245z belongs to event
 #: btc-updown-15m-2026-09-24-1245z. Derivable, so the event can be addressed
@@ -504,6 +549,10 @@ class PmusTransport:
         self.cancel_owner_oracle = None
         self._injected = http is not None
         self.http = http or Q1.ReadOnlyTransport()
+        #: built on first disarmed cancel. An injected http is a test's or a
+        #: wrapper's choice and is honoured for cancel too, so a shadow or
+        #: fake transport is never bypassed by this repair.
+        self._cancel_http = self.http if http is not None else None
         self._now = now_fn or (lambda: dt.datetime.now(dt.timezone.utc))
         self.armed = False
         self.preflight_report: Optional[Dict[str, Any]] = None
@@ -520,18 +569,24 @@ class PmusTransport:
     # ------------------------------------------------------------ read only
 
     def _request(self, method: str, path: str, body=None,
-                 base: str = Q1.API) -> Any:
+                 base: str = Q1.API, *, http: Optional[Any] = None) -> Any:
         """The single door every venue request goes through.
 
         Nothing here retries. A 429 is recorded, the shared cool-off is
         extended, and the error propagates to a caller that already knows
         how to fail closed. Retrying inside this function would be the
         fastest possible way to deepen a rate limit.
+
+        `http` overrides WHICH object sends it, and nothing else. The
+        disarmed cancel path passes `_CancelOnlyHTTP` so the one route it is
+        allowed to POST still goes through this door -- sharing the rate
+        limiter, the cool-off and the 429 accounting rather than opening a
+        second, unmetered path to the venue.
         """
         write = str(method).upper() != "GET"
         self.limiter.before(write=write)
         try:
-            out = self.http.request(method, path, body, base)
+            out = (http or self.http).request(method, path, body, base)
         except BaseException as exc:                           # noqa: BLE001
             if isinstance(exc, (KeyboardInterrupt, SystemExit)):
                 raise
@@ -1237,8 +1292,7 @@ class PmusTransport:
             # that must prove ownership. Without an oracle it cannot, and
             # there it refuses: absent is not permission for a NEW power.
             if self.armed:
-                return self._request(
-                    "POST", "/v1/order/%s/cancel" % oid, {}, Q1.API) or {}
+                return self._cancel_post(oid)
             raise CancelRefused(
                 "OWNERSHIP_UNESTABLISHED: this transport is disarmed and no "
                 "ledger oracle is installed, so it cannot prove the order is "
@@ -1252,5 +1306,21 @@ class PmusTransport:
                 "OWNERSHIP_UNREADABLE:%s" % type(exc).__name__)
         if not ours:
             raise CancelRefused("NOT_OUR_ORDER:%s" % oid[:40])
-        return self._request(
-            "POST", "/v1/order/%s/cancel" % oid, {}, Q1.API) or {}
+        return self._cancel_post(oid)
+
+    def _cancel_post(self, oid: str) -> Dict[str, Any]:
+        """Send the one cancel POST, by whichever object is allowed to.
+
+        ARMED is untouched: `self.http` is already `_SignedHTTP` and this is
+        byte-for-byte the request it always sent. DISARMED is the repair --
+        `self.http` is GET-only there, so the POST raised PermissionError and
+        the order stayed resting (see `_CancelOnlyHTTP`). Ownership has
+        already been proved by the caller; this only decides the sender.
+        """
+        path = "/v1/order/%s/cancel" % oid
+        if self.armed:
+            return self._request("POST", path, {}, Q1.API) or {}
+        if self._cancel_http is None:
+            self._cancel_http = _CancelOnlyHTTP()
+        return self._request("POST", path, {}, Q1.API,
+                             http=self._cancel_http) or {}
diff --git a/tests/test_l5_disarmed_cancel_http_permission.py b/tests/test_l5_disarmed_cancel_http_permission.py
new file mode 100644
index 00000000..67eb017d
--- /dev/null
+++ b/tests/test_l5_disarmed_cancel_http_permission.py
@@ -0,0 +1,153 @@
+"""The disarmed cancel must reach the wire, not die inside our own transport.
+
+WHY THESE EXIST AND test_l5_disarmed_cancellation.py WAS NOT ENOUGH. That
+file proves the GATE was removed -- cancel no longer raises NotArmed while
+disarmed. It cannot prove the request is SENDABLE, because its fixture
+injects a permissive `_HTTP` stub AND monkeypatches `_request`, so the real
+`pmus_auth.ReadOnlyTransport` that production actually holds while disarmed
+is never in the path. Production therefore failed where the suite passed:
+
+    2026-10-15T19:50:03Z  D47R06GG0ZRX  cpc-btc-...-1945z
+                          cancel_error PermissionError, left ORDER_STATE_NEW
+    2026-10-16T03:39:06Z  D4EFZNW00ZZ0  cpcxrp-xrp-...-0330z
+                          cancel_error PermissionError on every sweep while
+                          cumQuantity climbed 37.73 -> 47.92
+
+The second settled worthless at -37.9754. These tests use the REAL default
+transport -- no injected http -- and stub only the wire.
+"""
+from __future__ import annotations
+
+import pytest
+
+from src import l5_pmus_transport as T
+from src import pmus_auth as Q1
+
+
+VID = "D4EFZNW00ZZ0"
+SLUG = "cpcxrp-xrp-updown-15m-2026-10-16-0330z"
+
+
+@pytest.fixture
+def wire(monkeypatch):
+    """Record what _SignedHTTP would have sent; send nothing."""
+    sent = []
+
+    def _fake(self, method, path, body=None, base=Q1.API):
+        sent.append((str(method).upper(), path))
+        return {"id": VID, "state": "ORDER_STATE_CANCELED",
+                "leavesQuantity": "0"}
+
+    monkeypatch.setattr(T._SignedHTTP, "request", _fake)
+    monkeypatch.setattr(T.Q1, "has_credentials", lambda: True)
+    monkeypatch.setattr(T.Q1, "signed_headers",
+                        lambda *a, **k: {"X-Test": "1"})
+    return sent
+
+
+def real_disarmed():
+    """A REAL transport with the REAL default http, genuinely disarmed."""
+    tp = T.PmusTransport(market_slug=SLUG)          # no injected http
+    assert tp.armed is False
+    assert isinstance(tp.http, Q1.ReadOnlyTransport), (
+        "the fixture must hold the GET-only object production holds")
+    tp.cancel_owner_oracle = lambda vid: str(vid) == VID
+    return tp
+
+
+def test_the_default_disarmed_http_really_does_refuse_a_post():
+    """THE DEFECT, pinned. This is what production hit: the object the
+    disarmed transport holds cannot POST at all."""
+    tp = T.PmusTransport(market_slug=SLUG)
+    with pytest.raises(PermissionError):
+        tp.http.request("POST", "/v1/order/%s/cancel" % VID, {})
+
+
+def test_a_disarmed_cancel_of_our_own_order_reaches_the_wire(wire):
+    """THE REPAIR. Ownership is proved, so the one cancel route is sent."""
+    tp = real_disarmed()
+    out = tp.cancel(VID)
+    assert wire == [("POST", "/v1/order/%s/cancel" % VID)]
+    assert out.get("state") == "ORDER_STATE_CANCELED"
+
+
+def test_the_disarmed_cancel_still_refuses_an_order_that_is_not_ours(wire):
+    """The repair widens WHAT CAN SEND, never WHAT MAY BE CANCELLED."""
+    tp = real_disarmed()
+    with pytest.raises(T.CancelRefused) as e:
+        tp.cancel("D23N1EHTTZ7D")              # the owner's manual order
+    assert "NOT_OUR_ORDER" in str(e.value)
+    assert wire == [], "nothing may reach the venue for an order we disown"
+
+
+def test_the_disarmed_cancel_still_refuses_with_no_oracle(wire):
+    """Absent is not permission for the disarmed capability."""
+    tp = T.PmusTransport(market_slug=SLUG)
+    with pytest.raises(T.CancelRefused) as e:
+        tp.cancel(VID)
+    assert "OWNERSHIP_UNESTABLISHED" in str(e.value)
+    assert wire == []
+
+
+def test_the_disarmed_cancel_still_refuses_without_credentials(monkeypatch,
+                                                               wire):
+    monkeypatch.setattr(T.Q1, "has_credentials", lambda: False)
+    tp = real_disarmed()
+    with pytest.raises(T.CancelRefused) as e:
+        tp.cancel(VID)
+    assert "NO_CREDENTIALS" in str(e.value)
+    assert wire == []
+
+
+@pytest.mark.parametrize("method,path", [
+    ("POST", "/v1/order"),                       # submit
+    ("POST", "/v1/orders"),                      # submit, plural
+    ("POST", "/v1/orders/cancel"),               # account-wide
+    ("POST", "/v1/order/cancel-all"),            # account-wide
+    ("POST", "/v1/order/%s/cancel/extra" % VID),  # path smuggling
+    ("POST", "/v1/order/%s/cancel?all=1" % VID),  # query smuggling
+    ("DELETE", "/v1/order/%s" % VID),
+    ("PUT", "/v1/order/%s/cancel" % VID),
+])
+def test_the_cancel_only_http_refuses_everything_but_one_route(method, path):
+    """The refusal lives in the OBJECT, so this cannot be argued into a
+    submit or into an account-wide cancellation."""
+    with pytest.raises(PermissionError):
+        T._CancelOnlyHTTP().request(method, path, {})
+
+
+def test_the_cancel_only_http_permits_exactly_the_one_route(wire):
+    sent = T._CancelOnlyHTTP().request(
+        "POST", "/v1/order/%s/cancel" % VID, {})
+    assert sent.get("state") == "ORDER_STATE_CANCELED"
+    assert wire == [("POST", "/v1/order/%s/cancel" % VID)]
+
+
+def test_the_disarmed_cancel_goes_through_the_shared_rate_limiter(wire):
+    """Not a second, unmetered door to the venue: the one cancel POST is
+    still counted as a write by the process-wide limiter."""
+    tp = real_disarmed()
+    seen = []
+    tp.limiter = type("L", (), {
+        "before": lambda _s, write=False: seen.append(("before", write)),
+        "on_success": lambda _s: seen.append(("ok", None)),
+        "on_429": lambda _s: seen.append(("429", None))})()
+    tp.cancel(VID)
+    assert ("before", True) in seen and ("ok", None) in seen
+
+
+def test_an_injected_transport_is_honoured_for_cancel_too(wire):
+    """A wrapper's or a test's injected http is never bypassed by the
+    repair -- otherwise this would be a hole around ShadowOnlyTransport."""
+    calls = []
+
+    class _Inj:
+        def request(self, method, path, body=None, *a, **k):
+            calls.append((method, path))
+            return {"state": "ORDER_STATE_CANCELED"}
+
+    tp = T.PmusTransport(market_slug=SLUG, http=_Inj())
+    tp.cancel_owner_oracle = lambda vid: True
+    tp.cancel(VID)
+    assert calls == [("POST", "/v1/order/%s/cancel" % VID)]
+    assert wire == [], "the injected object sent it, not a fresh signed one"
