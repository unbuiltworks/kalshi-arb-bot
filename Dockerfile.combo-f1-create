FROM python:3.11-slim
WORKDIR /app
ENV PYTHONPATH=/app
ENV BOT_MODE=paper
COPY requirements.txt .
RUN pip install --no-cache-dir -r requirements.txt
COPY src/ src/
COPY config/ config/
RUN python -m py_compile src/gemini_f1_albon_alonso_combo_create_probe.py src/gemini_prediction_auth.py
CMD ["python", "-m", "src.gemini_f1_albon_alonso_combo_create_probe"]
