KALSHI_ENV=prod
KALSHI_API_KEY_ID=your_kalshi_api_key_id
KALSHI_PRIVATE_KEY_PATH=./private_key.pem

# Polymarket US authenticated trading API.
# Keep the secret in your deployment environment; never commit real credentials.
POLYMARKET_KEY_ID=your_polymarket_key_id
POLYMARKET_SECRET_KEY=your_polymarket_secret_key

# Optional FanDuel + Kalshi lane via OpticOdds.
OPTICODDS_API_KEY=your_opticodds_api_key
CROSS_MARKET_SPORTSBOOKS=FanDuel
