KALSHI_ENV=prod
KALSHI_API_KEY_ID=your_kalshi_api_key_id
KALSHI_PRIVATE_KEY_PATH=./private_key.pem

# Gemini Prediction Markets. Never commit real values.
# Use an account-scoped key (account-...), enable time-based nonce, and Trader role.
GEMINI_API_KEY=your_account_scoped_gemini_api_key
GEMINI_API_SECRET=your_gemini_api_secret

# Live Gemini/Kalshi probes remain disabled unless explicitly enabled later.
ENABLE_GEMINI_KALSHI_LIVE_PROBES=NO

# Polymarket US API credentials. Never commit real values.
POLYMARKET_KEY_ID=your_polymarket_key_id
POLYMARKET_SECRET_KEY=your_polymarket_secret_key
