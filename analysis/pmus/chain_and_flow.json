{
 "title": "Post-first-fill chain, and flow metrics separating BOOK REACH from EXECUTABLE RECYCLING",
 "as_of_utc": "2026-09-20T11:36:33Z",
 "interim_checkpoint": "25 FIRST FILLS (29 reached: PMUS 11 + INTL 18). EARLY. No transfer verdict drawn. Next checkpoints 50 and 100.",
 "labels": "SHADOW/HYPOTHETICAL. No orders, no arming, no live capital. Nothing is submitted, filled, settled or realized. No Model A change, no habitat threshold change, no parameter optimization.",
 "HEADLINE_1": "BOOK REACH AND EXECUTABLE RECYCLING ARE DIFFERENT HABITATS and ranking on reach put the wrong markets on top. P(reach followed by a COMPATIBLE print within 60s): PMUS cs2 match_winner 76.9% (n=39), PMUS valorant 77.8% (n=9), INTL dota2 27.7% (n=47), INTL cs2 10.2% (n=98), INTL wta 6.7% (n=30) -- the BEST habitat by reach -- and PMUS atpcq tennis 0.0% (n=14), ranked 4th by reach on the largest reach sample in the study.",
 "HEADLINE_2": "The chain breaks on the POLICY side. 1a_POLICY_NEVER_RECOMMENDED_COMPLETE is 90.9% of PMUS and 77.8% of INTL first fills: the v2 model returns open/extend until the residual cap blocks and never asks for the complement. That is the frozen policy's behaviour in these states, NOT evidence the market could not supply a complement.",
 "A_MEASUREMENT_BUG_FOUND_AND_FIXED": {
  "what": "flow rates were divided by the BOOK observation span while the flow tap started later, so every rate was divided by minutes with no flow recorded at all.",
  "effect": "UNDERSTATED flow and made the negative result look stronger than the data supports. PMUS cs2 reach-to-trade@60s 22.0% -> 76.9%; PMUS valorant 17.5% -> 77.8%.",
  "fix": "every flow metric windowed to the INTERSECTION of book and flow coverage (PMUS from 11:30:07Z, INTL from 11:23:57Z).",
  "why_recorded": "the uncorrected numbers supported a conclusion already reported; they were wrong."
 },
 "chain_definitions": {
  "frozen_policy": "Inventory, plan_action, complement_target and pv2.proposal imported UNMODIFIED, model sha16 bbb55bf90638d2bd. Only MAX_ACTIONS is not applied -- the module documents it as bounded STATUS EMISSION, a display cap, not a policy parameter; following a chain to completion requires lifting it. DECISION_MIN_GAP_S (30s) is kept.",
  "two_fill_models": "OPTIMISTIC (any compatible print at/through the resting price; the module's `possible` class; UPPER bound) and QUEUE_AWARE (cumulative compatible volume must EXCEED depth resting at our price when we joined; LOWER bound). Never collapsed to one number.",
  "no_fill_from_reach_alone": "A fill is NEVER inferred because ask <= resting bid; book reach is its own step and a compatible PRINT is required beyond it.",
  "censoring": "CENSORED until observed 300s after first fill -- the longest opposite-flow horizon in the mandate. Only MATCHED assigned early."
 },
 "failure_modes": {
  "1a_POLICY_NEVER_RECOMMENDED_COMPLETE": "v2 returned open/extend; residual cap blocked. POLICY-side.",
  "1b_COMPLEMENT_NO_LEGAL_PRICE": "complete recommended, no fee-safe maker price. ECONOMICS-side.",
  "2_COMPLEMENT_QUOTED_NEVER_REACHED": "quoted, book never reached it.",
  "3_REACHED_NO_COMPATIBLE_TRADE": "reached, no compatible print.",
  "4_TRADE_BUT_INSUFFICIENT_QUEUE_EVIDENCE": "compatible print(s) but cumulative volume did not exceed depth ahead.",
  "5_OPPOSITE_FILL_QTY_MISMATCH": "opposite fill, quantities did not match.",
  "6_MATCHED": "matched inventory achieved.",
  "7_CENSORED_TOO_LITTLE_POST_FILL_OBSERVATION": "undecided, NOT a failure."
 },
