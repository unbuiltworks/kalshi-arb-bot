+
+
+def test_the_lane_is_missing_a_fill_the_venue_has(store, lane, on):
+    lane["doc"] = lane_doc(WINDOW[:-1])
+    assert "ORDER_SETS_DIFFER:venue_only=1,sibling_only=0" in refused(
