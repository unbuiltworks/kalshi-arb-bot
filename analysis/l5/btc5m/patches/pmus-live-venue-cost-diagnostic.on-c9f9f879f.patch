From 3390246e03203e7b13ec33ba587fdee399ea2ba1 Mon Sep 17 00:00:00 2001
From: Claude <noreply@anthropic.com>
Date: Thu, 19 Nov 2026 23:49:05 +0000
Subject: [PATCH 2/2] l5-pmus-live diagnostic: list deposits and transfers the
 same walk passes over; prove a restart cannot correct an exhausted row

FeedTap is a GET-only pass-through that records the feed's non-trading
rows (deposits, transfers, bonuses) so the ledger total can be checked
against the venue balance since the re-anchor. It returns the venue's
answer untouched; amounts are listed as served and compared with nothing.

New test: a fresh process on the saved ledger, with a feed that now
reconciles exactly, reads nothing for exhausted rows and corrects nothing.

36 tests. Not deployed.

Co-Authored-By: Claude Fable 5.2 <noreply@anthropic.com>
Claude-Session: https://claude.ai/code/session_01HTk927uH8zwpj6gLES92PF
---
 src/l5_venue_cost_diagnostic.py        | 110 ++++++++++++++++++++++++-
 tests/test_l5_venue_cost_diagnostic.py | 100 ++++++++++++++++++++++
 2 files changed, 208 insertions(+), 2 deletions(-)

diff --git a/src/l5_venue_cost_diagnostic.py b/src/l5_venue_cost_diagnostic.py
index 25ce461fb..cfdef7158 100644
--- a/src/l5_venue_cost_diagnostic.py
+++ b/src/l5_venue_cost_diagnostic.py
@@ -151,6 +151,107 @@ def rebase_overlap(store: Any) -> Dict[str, Any]:
     return out
 
 
+#: activity kinds that are trading, not money moving in or out of the account
+_TRADING_KINDS = frozenset(CBA.FILL_KINDS) | frozenset(
+    ("activity_type_position_resolution", "position_resolution"))
+MAX_CASH_ROWS = 200
+
+
+class FeedTap:
+    """A GET-only pass-through that remembers the feed's NON-trading rows.
+
+    WHY. Whether the ledger total is right can be checked against the venue
+    balance only if deposits, withdrawals, transfers and bonuses over the
+    same period are known. The feed this diagnostic already reads carries
+    them; the attestation's reader drops every row that is not a fill for a
+    market it wants. This keeps a small record of the rest. It exposes one
+    verb, `_get`, forwards it unchanged and returns the venue's answer
+    untouched, so the walk reads exactly what it would have read.
+    """
+
+    def __init__(self, transport: Any) -> None:
+        self._t = transport
+        self.rows: Dict[str, Dict[str, Any]] = {}
+        self.dropped = 0
+
+    def _get(self, path: str) -> Any:
+        body = CBA._get(self._t, path)
+        try:
+            self._note(body)
+        except Exception:                                      # noqa: BLE001
+            self.dropped += 1
+        return body
+
+    def _note(self, body: Any) -> None:
+        if not isinstance(body, Mapping):
+            return
+        page = body.get("activities")
+        if not isinstance(page, list):
+            page = body.get("rows") if isinstance(body.get("rows"), list) \
+                else []
+        for r in page:
+            if not isinstance(r, Mapping):
+                continue
+            kind = str(r.get("type") or r.get("kind") or "").lower()
+            if not kind or kind in _TRADING_KINDS:
+                continue
+            inner = None
+            for v in r.values():
+                if isinstance(v, Mapping):
