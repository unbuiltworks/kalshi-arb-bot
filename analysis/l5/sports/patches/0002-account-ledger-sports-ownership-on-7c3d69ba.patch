+    box["doc"] = sports_doc()
+    got = go()
+    assert got["attested"] is True and got["origin"] == "SPORTS"
+    assert got["source"] == \
+        "SPORTS_LEDGER_FILLS_CONFIRMED_BY_VENUE_ORDER_READS"
+    assert emitted[-1][0] == "L5_OTHER_STRATEGY_COST"
