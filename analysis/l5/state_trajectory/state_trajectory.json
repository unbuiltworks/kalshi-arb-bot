 "gemini_required_schema": {
  "minimum_to_be_usable": {
   "complement_fills": ">= 30",
   "matched_campaigns": ">= 30 with a formed pair",
   "reason": "below that the gain_per_unit and pair-cost distributions cannot be compared to L5's 21,739 switches at any useful resolution"
  },
  "must_not_be_sent": [
   "assumed or imputed fills of any kind",
   "mid-proxy settlements presented as realized",
   "aggregates in place of the fill stream"
  ],
  "purpose": "one row PER FILL, chronological within an episode, so src/l5_state_trajectory.walk can build the identical states for Gemini that it builds for L5 and PMUS. Return fills, not summaries: every distribution in this study is rebuilt from the fill stream and cannot be recovered from aggregates.",
  "query_shape": "SELECT episode_id, venue_duration, seq, t, side, price, qty, tte_s, maker_taker, sampled, acted, refusal FROM fills WHERE filled = true ORDER BY episode_id, seq",
  "required_fields": {
   "episode_id": "str -- one market window / campaign",
   "maker_taker": "'maker' | 'taker' | 'unknown'",
   "price": "float in (0,1)",
   "qty": "float contracts filled",
   "seq": "int -- 1-based order within the episode",
   "side": "'up' | 'dn' -- the OUTCOME bought, not BUY/SELL",
   "t": "float epoch seconds of the FILL (not the order)",
   "tte_s": "float seconds to settlement AT THE FILL",
   "venue_duration": "str -- '5m' | '15m'"
  },
  "required_if_a_shell_selected_the_action": {
   "acted": "the action actually taken",
   "refusal": "the gate that changed it, or null",
   "sampled": "the action the model drew, before any shell gate"
  },
  "required_per_episode": {
   "realized_usd": "venue-confirmed, or null -- never a proxy",
   "settlement_outcome": "'up' | 'dn' | null if unsettled",
   "terminal_dn": "float",
   "terminal_up": "float"
  }
 },
 "method": {
  "alignment": "episodes aligned at the FIRST FILL",
  "l5_non_buy_prints_dropped": 2,
  "no_lookahead": "every state is built from fills strictly before it plus the action being taken",
  "one_walker": "both venues are reconstructed by src/l5_state_trajectory.walk from a common fill record, so the comparison cannot measure two different reconstructions",
  "pmus_cadence_is_an_upper_bound": "a fill is stamped with the decision that OBSERVED it",
  "pmus_fill_recovery": "from the engine's own inventory ledger between TIMESTAMPED decisions; 44 fills recovered against 45 order rows with filled_qty>0 -- the one difference is a fill with no subsequent decision to observe it",
  "pmus_unrecovered_fills": 0
 },
