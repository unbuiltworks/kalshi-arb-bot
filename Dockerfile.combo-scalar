FROM python:3.11-slim

WORKDIR /app
ENV PYTHONPATH=/app
ENV BOT_MODE=paper

COPY requirements.txt .
RUN pip install --no-cache-dir -r requirements.txt
COPY src/ src/
COPY config/ config/

# Isolated Gemini combo definition/rule audit. Creates or retrieves one combo
# definition only; no order entry or capital action.
RUN python -m py_compile src/gemini_tor_mia_combo_create_audit.py src/gemini_prediction_auth.py src/gemini_sports_inventory.py
CMD ["python", "-m", "src.gemini_tor_mia_combo_create_audit"]
