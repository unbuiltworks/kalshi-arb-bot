FROM python:3.11-slim

WORKDIR /app
ENV PYTHONPATH=/app
ENV BOT_MODE=paper

COPY requirements.txt .
RUN pip install --no-cache-dir -r requirements.txt
COPY src/ src/
COPY config/ config/

# Isolated zero-capital Gemini combo definition validation. No order entry.
RUN python -m py_compile src/gemini_extreme_combo_create_validation.py src/gemini_prediction_auth.py
CMD ["python", "-m", "src.gemini_extreme_combo_create_validation"]
