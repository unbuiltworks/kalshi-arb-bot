FROM python:3.11-slim

WORKDIR /app
ENV PYTHONPATH=/app
ENV BOT_MODE=paper

COPY requirements.txt .
RUN pip install --no-cache-dir -r requirements.txt
COPY src/ src/
COPY config/ config/

# Isolated read-only Gemini combo pricing probe. No order entry.
RUN python -m py_compile src/gemini_mlb_combo_scalar_probe.py src/three_venue_pricing_core.py
CMD ["python", "-m", "src.gemini_mlb_combo_scalar_probe"]
