{
  "$schema": "https://railway.app/railway.schema.json",
  "build": {
    "builder": "DOCKERFILE",
    "dockerfilePath": "deploy/completion_shadow/Dockerfile"
  },
  "deploy": {
    "startCommand": "python3 -m src.pmus_completion_shadow",
    "restartPolicyType": "ALWAYS",
    "restartPolicyMaxRetries": 100
  },
  "watchPatterns": [
    "src/pmus_completion_shadow.py",
    "src/pmus_persistence_window.py",
    "src/pmus_flow_roster.py",
    "src/pmus_sports_collector.py",
    "deploy/completion_shadow/**"
  ]
}
