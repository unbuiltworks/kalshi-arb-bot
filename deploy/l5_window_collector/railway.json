{
  "$schema": "https://railway.app/railway.schema.json",
  "build": {
    "builder": "DOCKERFILE",
    "dockerfilePath": "deploy/l5_window_collector/Dockerfile",
    "watchPatterns": [
      "deploy/l5_window_collector/**",
      "src/l5_window_collector.py",
      "scripts/l5_window_collector_run.py"
    ]
  },
  "deploy": {
    "startCommand": "python3 -m scripts.l5_window_collector_run",
    "restartPolicyType": "ALWAYS"
  }
}
