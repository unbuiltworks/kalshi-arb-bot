{
  "$schema": "https://railway.com/railway.schema.json",
  "build": {
    "builder": "DOCKERFILE",
    "dockerfilePath": "deploy/pmus_shadow_breadth/Dockerfile",
    "watchPatterns": [
      "deploy/pmus_shadow_breadth/**",
      "src/pmus_sports_shadow_breadth.py",
      "src/pmus_sports_opportunity_rank.py"
    ]
  },
  "deploy": {
    "startCommand": "python3 -m src.pmus_sports_shadow_breadth",
    "restartPolicyType": "ON_FAILURE",
    "restartPolicyMaxRetries": 10
  }
}
