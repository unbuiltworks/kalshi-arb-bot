.env
private_key.pem
venv/
__pycache__/
*.pyc
*.log
.pytest_cache/
*.egg-info/
dist/
build/

# L5: normalized JSONL is derived from data/l5/raw by 'cli build'; keep the source of truth only
data/l5/normalized/

# L5 backfill: ~300MB slim raw cache, regenerable via 'python -m src.polymarket_l5.backfill'
data/l5/raw/activity_gap.jsonl

# policy_d_port raw tapes: the JSONL for a multi-hour run is 80-90MB, past
# GitHub's 50MB warning, and a growing file costs a full new blob on every
# snapshot commit. Track the gzipped tape instead (~9.5x smaller); the raw
# file stays on disk for the running collector. Same rule already in force
# on claude/polymarket-l5-historical-analysis-2ih9ui (6524704b), where the
# 2026-09-04 and 2026-09-05 tapes are committed in their .gz form.
data/policy_d_port/tape_*.jsonl

# Same rule, same reason, for the 2026-09-17 measurement runs: the Gemini
# hot-window tape and the PMUS book tape are both written continuously by a
# live collector, so the raw JSONL is a growing file that would cost a fresh
# multi-MB blob on every commit while the run is in flight. The RAW TAPE IS
# PRESERVED ON DISK for the collector and for provenance, and the GZIPPED
# tape is committed once the run completes -- which is also the only point at
# which the file is a complete, citable artifact rather than a partial one.
data/policy_d_port_hot/tape_*.jsonl
data/policy_d_port_hot/canonical_*.jsonl
data/pmus_book_tape/pmus_book_*.jsonl
data/policy_d_port_hot/*.jsonl.gz
data/pmus_book_tape/*.jsonl.gz

# prospective FIDELITY rows are runtime research state, not source code.
# The v0 snapshots already committed stay committed; nothing is rewritten.
analysis/l5/fidelity/prospective/*.jsonl

# Chain receipt fetch cache. Derived and regenerable: immutable public receipts,
# re-fetchable from any archive node, and it churns while a study is running.
# The tx-level PROVENANCE is not here -- every row of the committed
# roles_*.json carries its own tx, block, logIndex and contract, which is the
# auditable artifact.
analysis/l5/pair_formation/receipts.jsonl

# Historical-L2 chain backfill + block-time fetch caches. Derived and
# regenerable from immutable public chain data; the findings and the tables
# they produce are committed instead.
analysis/l5/historical_l2/l5_backfill.json
analysis/l5/historical_l2/block_times.json
data/l5_book_context/*.jsonl
data/gemini_surface_shadow/*.jsonl
data/l5_window_forensics/*.jsonl

# P10 captures in flight: renamed into place only when complete
analysis/gemini/p10_capture/*.partial
data/pmus_btc15m/
data/l5_pmus_realtime/
data/pmus_auth_trades/

# Local working copies of collected tapes. The evidence that matters is
# committed under analysis/pmus/evidence/ -- these are the scratch paths the
# harvest scripts write to and are byte-identical duplicates of it, so
# committing them would double ~16MB for nothing. The container is ephemeral;
# anything worth keeping goes to analysis/pmus/evidence/ and is committed.
data/l5_pmus_realtime/
data/pmus_auth_trades/
data/pmus_btc15m/

# P10 decoder capture. That workstream is closed and GATE FAILED; its capture
# is not revived, merged or modified.
analysis/gemini/p10_capture/
